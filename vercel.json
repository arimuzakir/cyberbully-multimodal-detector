{
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS,HEAD" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py?__route=/:path*" },
    { "source": "/predict", "destination": "/api/index.py?__route=/predict" },
    { "source": "/predict-(.*)", "destination": "/api/index.py?__route=/predict-$1" },
    { "source": "/extension/:path*", "destination": "/api/index.py?__route=/extension/:path*" },
    { "source": "/download-extension", "destination": "/api/index.py?__route=/download-extension" },
    { "source": "/health", "destination": "/api/index.py?__route=/health" },
    { "source": "/docs", "destination": "/api/index.py?__route=/docs" },
    { "source": "/openapi.json", "destination": "/api/index.py?__route=/openapi.json" }
  ]
}
